        <mxCell id="n18" value="git ls-files per repository&lt;br&gt;SHA-1 of every file&lt;br&gt;reads back the indexed digests" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n16"><mxGeometry x="340" y="36" width="480" height="50" as="geometry"/></mxCell>
        <mxCell id="n19" value="3.0 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n16"><mxGeometry x="840" y="36" width="290" height="50" as="geometry"/></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n11" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n21" value="step 5/8  ·  chunking what changed" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1150" height="100" as="geometry"/></mxCell>
        <mxCell id="n22" value="chunkers/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n21"><mxGeometry x="20" y="36" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="n23" value="markdown · javascript · vue · json · yaml · shell&lt;br&gt;one chunker per extension&lt;br&gt;line ranges located by content" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n21"><mxGeometry x="340" y="36" width="480" height="50" as="geometry"/></mxCell>
        <mxCell id="n24" value="86 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n21"><mxGeometry x="840" y="36" width="290" height="50" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n16" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n26" value="step 6/8  ·  embedding and indexing" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1150" height="100" as="geometry"/></mxCell>
        <mxCell id="n27" value="clients/embeddings.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n26"><mxGeometry x="20" y="36" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="n28" value="Qwen3-Embedding-0.6B on CPU&lt;br&gt;batch of 8 · ~1.3 chunk/s&lt;br&gt;deletes then upserts per file" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n26"><mxGeometry x="340" y="36" width="480" height="50" as="geometry"/></mxCell>
        <mxCell id="n29" value="1 min 11 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n26"><mxGeometry x="840" y="36" width="290" height="50" as="geometry"/></mxCell>
        <mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n21" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n31" value="step 7/8  ·  building the dependency graph" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#DCD4ED;strokeColor=#6E5AA6;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1150" height="100" as="geometry"/></mxCell>
        <mxCell id="n32" value="pipeline/dependency_graph.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n31"><mxGeometry x="20" y="36" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="n33" value="parses imports of js/vue&lt;br&gt;resolves relative + @kalisio/*&lt;br&gt;rebuilt whole, never incrementally" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n31"><mxGeometry x="340" y="36" width="480" height="50" as="geometry"/></mxCell>
        <mxCell id="n34" value="~1 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n31"><mxGeometry x="840" y="36" width="290" height="50" as="geometry"/></mxCell>
        <mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n26" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n36" value="step 8/8  ·  refreshing the file entries" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#DCD4ED;strokeColor=#6E5AA6;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1150" height="100" as="geometry"/></mxCell>
        <mxCell id="n37" value="pipeline/commit_history.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n36"><mxGeometry x="20" y="36" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="n38" value="one git log per repository&lt;br&gt;history + digest + graph&lt;br&gt;written in a single upsert" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n36"><mxGeometry x="340" y="36" width="480" height="50" as="geometry"/></mxCell>
        <mxCell id="n39" value="3.0 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n36"><mxGeometry x="840" y="36" width="290" height="50" as="geometry"/></mxCell>
        <mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n31" target="n36"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n41" value="Incremental by digest.&lt;br&gt;&lt;br&gt;Steps 5 and 6 only touch the files whose&lt;br&gt;SHA-1 changed: 156 of 4 208 on the last run.&lt;br&gt;&lt;br&gt;Steps 3, 4, 7 and 8 always do the whole&lt;br&gt;corpus — a clone cannot be partial, and a&lt;br&gt;graph cannot be: renaming B changes the&lt;br&gt;edges of every A that imports it, and those&lt;br&gt;A did not change." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="1220" y="80" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="n42" value="A run that dies leaves nothing half-written.&lt;br&gt;&lt;br&gt;The recovery cursor is captured before the&lt;br&gt;clone and stored only on success, so a failed&lt;br&gt;run never moves it forward and never lets a&lt;br&gt;file be skipped.&lt;br&gt;&lt;br&gt;A file entry is written after its chunks, so&lt;br&gt;an interrupted run leaves the older digest&lt;br&gt;and the file is reindexed rather than&lt;br&gt;wrongly considered done." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="1220" y="320" width="300" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="built-collections" name="built · Qdrant collections">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="What is actually stored. Payloads copied from a run, not from a specification." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="30" as="geometry"/></mxCell>
        <mxCell id="n2" value="kalisio_code  ·  one point per chunk" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="740" height="430" as="geometry"/></mxCell>
        <mxCell id="n3" value="vector: 1024 float · cosine · Qwen3-Embedding-0.6B&lt;br&gt;id: uuid5(repo : path : chunk_index : sha1(text))&lt;br&gt;32 630 points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n2"><mxGeometry x="20" y="40" width="700" height="60" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;payload&lt;/b&gt;&lt;br&gt;{&lt;br&gt;  &quot;repo&quot;:        &quot;kdk&quot;,&lt;br&gt;  &quot;path&quot;:        &quot;map/client/mixins/mixin.base-map.js&quot;,&lt;br&gt;  &quot;start_line&quot;:  45,&lt;br&gt;  &quot;end_line&quot;:    78,&lt;br&gt;  &quot;content&quot;:     &quot;Context: baseMapMixin &gt; center\n...&quot;,&lt;br&gt;  &quot;file_type&quot;:   &quot;js&quot;,&lt;br&gt;  &quot;chunk_index&quot;: 3,&lt;br&gt;  &quot;breadcrumb&quot;:  &quot;baseMapMixin &gt; center&quot;,&lt;br&gt;  &quot;content_sha1&quot;: &quot;9f2c...&quot;,&lt;br&gt;  &quot;file_sha1&quot;:   &quot;abc123...&quot;&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n2"><mxGeometry x="20" y="112" width="700" height="290" as="geometry"/></mxCell>
        <mxCell id="n5" value="kalisio_code_files  ·  one point per file" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="80" width="740" height="430" as="geometry"/></mxCell>
        <mxCell id="n6" value="vector: [0.0] — never searched, only retrieved&lt;br&gt;id: uuid5(&quot;file:&quot; + repo + &quot;:&quot; + path)&lt;br&gt;4 208 points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n5"><mxGeometry x="20" y="40" width="700" height="60" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;payload  —  test/data/expected/file_entry.json&lt;/b&gt;&lt;br&gt;{&lt;br&gt;  &quot;repo&quot;:     &quot;kdk&quot;,&lt;br&gt;  &quot;path&quot;:     &quot;core/client/store.js&quot;,&lt;br&gt;  &quot;commit_history&quot;: [&quot;fix: reset the store on logout&quot;, &quot;...&quot;],&lt;br&gt;  &quot;file_sha1&quot;: &quot;&quot;,&lt;br&gt;  &quot;dependents&quot;:   [&quot;kdk/core.client.js&quot;,&lt;br&gt;                   &quot;kdk/core/client/api.js&quot;],&lt;br&gt;  &quot;dependencies&quot;: [],&lt;br&gt;  &quot;churn&quot;: 87,&lt;br&gt;  &quot;cochange_partners&quot;: [{&quot;path&quot;: &quot;kdk/core/client/api.js&quot;, &quot;count&quot;: 31}]&lt;br&gt;}&lt;br&gt;&lt;br&gt;// file_sha1 is empty here: this file produces chunks,&lt;br&gt;// so its digest lives on them. Only a file that yields&lt;br&gt;// no chunk carries its digest on the entry." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n5"><mxGeometry x="20" y="112" width="700" height="290" as="geometry"/></mxCell>
        <mxCell id="n8" value="knowledge_metadata  ·  exactly one point" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="740" height="230" as="geometry"/></mxCell>
        <mxCell id="n9" value="vector: [0.0]   ·   id: uuid5(&quot;indexing_state&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n8"><mxGeometry x="20" y="40" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;payload&lt;/b&gt;&lt;br&gt;{&lt;br&gt;  &quot;last_ingestion&quot;:   &quot;2026-08-31T03:00:12.897641+00:00&quot;,&lt;br&gt;  &quot;embedding_model&quot;:  &quot;Qwen/Qwen3-Embedding-0.6B&quot;,&lt;br&gt;  &quot;chunking_version&quot;: 4&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n8"><mxGeometry x="20" y="92" width="700" height="120" as="geometry"/></mxCell>
        <mxCell id="n11" value="Why the commit history and the graph sit on their own point&lt;br&gt;&lt;br&gt;Both are properties of a file, not of a chunk. Stored on the&lt;br&gt;chunks, a file cut into twenty pieces carried twenty copies of&lt;br&gt;its history — which is what made a real history unaffordable.&lt;br&gt;&lt;br&gt;One point per file also gives a deterministic id, so the API&lt;br&gt;answers &quot;who imports this?&quot; with a retrieve by key rather than&lt;br&gt;a scan of 32 630 points.&lt;br&gt;&lt;br&gt;A change of embedding_model or chunking_version recreates&lt;br&gt;kalisio_code and kalisio_code_files together: chunks written&lt;br&gt;under an older contract cannot even be matched for deletion." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="820" y="540" width="740" height="230" as="geometry"/></mxCell>
        <mxCell id="n12" value="Change detection reads the digests from two places: the chunk payloads (the file has chunks) and the file&lt;br&gt;entries (the file yields none). The chunks win where both know a file — losing the code collection must mean a&lt;br&gt;full reindex, and the file entries survive it." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1520" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="built-api-mcp" name="built · API and MCP">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="One FastAPI application. The MCP is a mounted ASGI sub-app, not a second service." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="30" as="geometry"/></mxCell>
        <mxCell id="n2" value="HTTP routes  ·  api/routes.py" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="420" height="330" as="geometry"/></mxCell>
        <mxCell id="n3" value="GET  /health              (no token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n2"><mxGeometry x="20" y="40" width="380" height="34" as="geometry"/></mxCell>
        <mxCell id="n4" value="POST /search      Depends(verify_jwt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="n2"><mxGeometry x="20" y="84" width="380" height="34" as="geometry"/></mxCell>
        <mxCell id="n5" value="POST /ask         Depends(verify_jwt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="n2"><mxGeometry x="20" y="128" width="380" height="34" as="geometry"/></mxCell>
        <mxCell id="n6" value="POST /file-context  Depends(verify_jwt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="n2"><mxGeometry x="20" y="172" width="380" height="34" as="geometry"/></mxCell>
        <mxCell id="n7" value="The token is declared route by route, not&lt;br&gt;globally: /health has none on purpose, or&lt;br&gt;the Kubernetes probes would fail." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n2"><mxGeometry x="20" y="216" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="n8" value="MCP  ·  api/services/mcp.py" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#DCD4ED;strokeColor=#6E5AA6;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="460" height="330" as="geometry"/></mxCell>
        <mxCell id="n9" value="app.mount(&quot;/mcp&quot;, BearerJWTMiddleware(...))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCD4ED;strokeColor=#6E5AA6;" vertex="1" parent="n8"><mxGeometry x="20" y="40" width="420" height="40" as="geometry"/></mxCell>
        <mxCell id="n10" value="tool: search_code(query, top_k=5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n8"><mxGeometry x="20" y="92" width="420" height="34" as="geometry"/></mxCell>
        <mxCell id="n11" value="tool: get_file_context(repo, path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n8"><mxGeometry x="20" y="136" width="420" height="34" as="geometry"/></mxCell>
        <mxCell id="n12" value="A mount is raw ASGI: FastAPI dependencies&lt;br&gt;never run, so the token is checked by a&lt;br&gt;middleware that calls the same verify_jwt.&lt;br&gt;&lt;br&gt;TrailingSlashMiddleware serves /mcp and&lt;br&gt;/mcp/ alike — the redirect between them&lt;br&gt;looped forever behind the ingress." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n8"><mxGeometry x="20" y="180" width="420" height="126" as="geometry"/></mxCell>
        <mxCell id="n13" value="Services  ·  api/services/" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="560" height="330" as="geometry"/></mxCell>
        <mxCell id="n14" value="retrieval.py&lt;br&gt;answer_question · search_chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n13"><mxGeometry x="20" y="40" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="n15" value="dependencies.py&lt;br&gt;get_file_context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n13"><mxGeometry x="290" y="40" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="n16" value="security.py&lt;br&gt;verify_jwt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n13"><mxGeometry x="20" y="112" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="n17" value="mcp.py&lt;br&gt;build_server · build_http_app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n13"><mxGeometry x="290" y="112" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="n18" value="The MCP tools call these functions directly in Python.&lt;br&gt;There is no internal HTTP hop: search_code and&lt;br&gt;POST /search enter the same function, with the same&lt;br&gt;bounds (query ≤ 2000 chars, 1 ≤ top_k ≤ 50), so one&lt;br&gt;transport can never ask for what the other refuses." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n13"><mxGeometry x="20" y="184" width="520" height="122" as="geometry"/></mxCell>
        <mxCell id="n19" value="Clients  ·  api/clients/" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1000" y="440" width="560" height="240" as="geometry"/></mxCell>
        <mxCell id="n20" value="vectordb.py&lt;br&gt;search() · get_file_entry()&lt;br&gt;get_commit_histories()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n19"><mxGeometry x="20" y="40" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="n21" value="embeddings.py&lt;br&gt;encode() — query prompt,&lt;br&gt;asymmetric with the documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n19"><mxGeometry x="290" y="40" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="n22" value="QdrantUnreachable → 503, LLMUnreachable → 503.&lt;br&gt;A dependency being down is an outage, not a bad&lt;br&gt;request: the caller reads a reason, not a bare 500." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n19"><mxGeometry x="20" y="122" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="n23" value="clients/llm.py → OpenAI-compatible endpoint&lt;br&gt;used by /ask only. search_code never calls an LLM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="500" y="440" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="n24" value="Qdrant&lt;br&gt;read-only from this service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n2" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n8" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n13" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n19" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e29" value="/ask" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n13" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n30" value="The one thing to remember about the mount&lt;br&gt;&lt;br&gt;Starlette matches a mount only below itself, so /mcp used to be answered with a 307 onto /mcp/. Behind the&lt;br&gt;ingress that Location carried the scheme uvicorn sees — http — nginx bounced it back to /mcp without the slash,&lt;br&gt;and every client looped until it gave up on TooManyRedirects. Both spellings are now served directly, and&lt;br&gt;api/bin.py passes proxy_headers=True with forwarded_allow_ips=&quot;*&quot; so the proxy&#x27;s headers are trusted." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="900" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="built-examples" name="built · request and response examples">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="Real exchanges, captured against the deployed service." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1540" height="30" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;HTTP · retrieval  —  ~1 100 tokens for top_k=5&lt;/b&gt;&lt;br&gt;POST /search    Authorization: Bearer &lt;jwt&gt;&lt;br&gt;{ &quot;query&quot;: &quot;catalogue de couches&quot;, &quot;top_k&quot;: 3 }&lt;br&gt;&lt;br&gt;200 OK&lt;br&gt;[ {&lt;br&gt;    &quot;path&quot;: &quot;docs/api/map/map-mixins.md&quot;,&lt;br&gt;    &quot;repo&quot;: &quot;kdk&quot;,&lt;br&gt;    &quot;lines&quot;: &quot;11-15&quot;,&lt;br&gt;    &quot;score&quot;: 0.673,&lt;br&gt;    &quot;content&quot;: &quot;Context: Map Mixins &gt; Base Map\n...&quot;,&lt;br&gt;    &quot;commit_history&quot;: [&quot;docs: added missing toGeoJson&quot;, &quot;...&quot;],&lt;br&gt;    &quot;breadcrumb&quot;: &quot;Map Mixins &gt; Base Map&quot;,&lt;br&gt;    &quot;chunk_index&quot;: 2&lt;br&gt;} ]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="760" height="250" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;HTTP · dependency graph  —  ~85 tokens typical&lt;/b&gt;&lt;br&gt;POST /file-context    Authorization: Bearer &lt;jwt&gt;&lt;br&gt;{ &quot;repo&quot;: &quot;kdk&quot;, &quot;path&quot;: &quot;core/client/store.js&quot; }&lt;br&gt;&lt;br&gt;200 OK&lt;br&gt;{&lt;br&gt;  &quot;repo&quot;: &quot;kdk&quot;,&lt;br&gt;  &quot;path&quot;: &quot;core/client/store.js&quot;,&lt;br&gt;  &quot;dependents&quot;: [&quot;kdk/core.client.js&quot;,&lt;br&gt;                 &quot;kdk/core/client/api.js&quot;],&lt;br&gt;  &quot;dependent_count&quot;: 31,&lt;br&gt;  &quot;truncated&quot;: false,&lt;br&gt;  &quot;dependencies&quot;: [&quot;kdk/core/client/events.js&quot;],&lt;br&gt;  &quot;indexed&quot;: true&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="740" height="250" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;MCP · tools/call&lt;/b&gt;&lt;br&gt;POST /mcp    Accept: application/json, text/event-stream&lt;br&gt;{ &quot;jsonrpc&quot;: &quot;2.0&quot;, &quot;id&quot;: 1, &quot;method&quot;: &quot;tools/call&quot;,&lt;br&gt;  &quot;params&quot;: { &quot;name&quot;: &quot;search_code&quot;,&lt;br&gt;              &quot;arguments&quot;: { &quot;query&quot;: &quot;layer catalog&quot;,&lt;br&gt;                             &quot;top_k&quot;: 3 } } }&lt;br&gt;&lt;br&gt;200 OK&lt;br&gt;{ &quot;jsonrpc&quot;: &quot;2.0&quot;, &quot;id&quot;: 1,&lt;br&gt;  &quot;result&quot;: {&lt;br&gt;    &quot;isError&quot;: false,&lt;br&gt;    &quot;structuredContent&quot;: { &quot;result&quot;: [ /* same chunks */ ] },&lt;br&gt;    &quot;content&quot;: [ { &quot;type&quot;: &quot;text&quot;, &quot;text&quot;: &quot;...&quot; } ] } }" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="760" height="300" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;MCP · tools/list&lt;/b&gt;&lt;br&gt;POST /mcp&lt;br&gt;{ &quot;jsonrpc&quot;: &quot;2.0&quot;, &quot;id&quot;: 1, &quot;method&quot;: &quot;tools/list&quot; }&lt;br&gt;&lt;br&gt;200 OK — 388 tokens, injected into every agent session&lt;br&gt;{ &quot;result&quot;: { &quot;tools&quot;: [&lt;br&gt;  { &quot;name&quot;: &quot;search_code&quot;,&lt;br&gt;    &quot;description&quot;: &quot;Search the Kalisio codebase ...&quot;,&lt;br&gt;    &quot;inputSchema&quot;: { &quot;properties&quot;: {&lt;br&gt;      &quot;query&quot;:  { &quot;type&quot;: &quot;string&quot;,  &quot;maxLength&quot;: 2000 },&lt;br&gt;      &quot;top_k&quot;:  { &quot;type&quot;: &quot;integer&quot;, &quot;minimum&quot;: 1,&lt;br&gt;                  &quot;maximum&quot;: 50, &quot;default&quot;: 5 } } } },&lt;br&gt;  { &quot;name&quot;: &quot;get_file_context&quot;, ... } ] } }" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="840" y="360" width="740" height="300" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;Failures a caller must handle&lt;/b&gt;&lt;br&gt;POST /mcp      (no Authorization header)&lt;br&gt;401  { &quot;detail&quot;: &quot;missing_bearer_token&quot; }&lt;br&gt;&lt;br&gt;POST /mcp      (expired or wrong audience)&lt;br&gt;401  { &quot;detail&quot;: &quot;invalid_token&quot; }&lt;br&gt;&lt;br&gt;POST /search   (Qdrant down)&lt;br&gt;503  { &quot;detail&quot;: &quot;cannot reach Qdrant at http://qdrant:6333&quot; }&lt;br&gt;&lt;br&gt;POST /ask      (LLM unreachable)&lt;br&gt;503  { &quot;detail&quot;: &quot;...&quot; }" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="760" height="210" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;The rest of the /mcp surface&lt;/b&gt;&lt;br&gt;GET  /mcp/   → opens an SSE stream (stateless: carries nothing)&lt;br&gt;PUT  /mcp/   → 405, as JSON-RPC&lt;br&gt;&lt;br&gt;JSON-RPC methods answered:&lt;br&gt;  initialize      the handshake, negotiates the version&lt;br&gt;  tools/list      the two tools and their schemas&lt;br&gt;  tools/call      runs one&lt;br&gt;  ping            keep-alive&lt;br&gt;  resources/list  answers, empty — none are exposed&lt;br&gt;  prompts/list    answers, empty" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="840" y="690" width="740" height="210" as="geometry"/></mxCell>
        <mxCell id="n8" value="Reading the two zeroes of get_file_context&lt;br&gt;&lt;br&gt;indexed: true  · dependent_count: 0   →  the graph covers this file and nothing imports it. A refactor is safe.&lt;br&gt;indexed: false · dependent_count: 0   →  the graph cannot speak for this file. Nothing can be concluded.&lt;br&gt;&lt;br&gt;Three cases produce the second: no entry at all, an entry written by an ingestion older than the graph, and a&lt;br&gt;file type the graph does not cover (markdown, json). They collapse on purpose — the honest answer is the same.&lt;br&gt;Between deploying the graph and the first nightly run that builds it, every file in the corpus is in that state." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1540" height="180" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="built-graph" name="built · dependency graph">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="ingestion/pipeline/dependency_graph.py — step 7. Measured on 7 repositories: 2 716 edges, 94% of imports resolved, 0.4 s." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="30" as="geometry"/></mxCell>
        <mxCell id="n2" value="1 · extract" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="360" height="300" as="geometry"/></mxCell>
        <mxCell id="n3" value="import x from &quot;./y&quot;&lt;br&gt;import &quot;./side-effect&quot;&lt;br&gt;export * from &quot;./y&quot;&lt;br&gt;require(&quot;./y&quot;)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n2"><mxGeometry x="20" y="40" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="n4" value="One regex, not tree-sitter.&lt;br&gt;&lt;br&gt;It misses the imports whose `from` sits on&lt;br&gt;another line: 32 out of 5 623, 0.6%.&lt;br&gt;&lt;br&gt;A missed import is an edge that is absent,&lt;br&gt;never an edge that is wrong." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n2"><mxGeometry x="20" y="156" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="n5" value="2 · resolve  (the real work)" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="480" height="300" as="geometry"/></mxCell>
        <mxCell id="n6" value="./store  →  ./store.js  ./store/index.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n5"><mxGeometry x="20" y="40" width="440" height="34" as="geometry"/></mxCell>
        <mxCell id="n7" value="@kalisio/kdk/core.client  →  kdk/core.client.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n5"><mxGeometry x="20" y="84" width="440" height="34" as="geometry"/></mxCell>
        <mxCell id="n8" value="vue, lodash  →  ignored (third party)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="n5"><mxGeometry x="20" y="128" width="440" height="34" as="geometry"/></mxCell>
        <mxCell id="n9" value="Every Kalisio import is a subpath — never a bare&lt;br&gt;@kalisio/kdk. Resolving only the package name&lt;br&gt;lost 209 of the 216 cross-repository edges.&lt;br&gt;&lt;br&gt;The package name comes from the package.json of&lt;br&gt;each repository, root and packages/* alike." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n5"><mxGeometry x="20" y="176" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="n10" value="3 · invert" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="300" height="300" as="geometry"/></mxCell>
        <mxCell id="n11" value="dependents[target]&lt;br&gt;    .append(source)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n10"><mxGeometry x="20" y="40" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="n12" value="No NetworkX.&lt;br&gt;&lt;br&gt;It was only there for PageRank and&lt;br&gt;Louvain, and measurement killed both:&lt;br&gt;PageRank ranks the barrels, Louvain&lt;br&gt;returns 91% singletons.&lt;br&gt;&lt;br&gt;One defaultdict does the rest." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n10"><mxGeometry x="20" y="146" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="n13" value="Never invented&lt;br&gt;&lt;br&gt;A specifier that resolves to a file&lt;br&gt;nobody scanned yields no edge at all.&lt;br&gt;&lt;br&gt;The prototype did the opposite — it&lt;br&gt;created kdk/index.js, a file that does&lt;br&gt;not exist, and that phantom node then&lt;br&gt;topped the PageRank ranking.&lt;br&gt;&lt;br&gt;A test pins this." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1300" y="80" width="260" height="300" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;test/data/graph — the four shapes an edge takes&lt;/b&gt;&lt;br&gt;// kdk/core/client/api.js&lt;br&gt;import { Store } from &quot;./store.js&quot;&lt;br&gt;&lt;br&gt;// kdk/core.client.js   (a barrel)&lt;br&gt;export * from &quot;./core/client/store.js&quot;&lt;br&gt;&lt;br&gt;// kano/client/components/KLayerList.vue&lt;br&gt;import { Store } from &quot;@kalisio/kdk/core.client&quot;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="620" height="230" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;test/data/expected/graph.json&lt;/b&gt;&lt;br&gt;&quot;kdk/core/client/store.js&quot;: {&lt;br&gt;  &quot;dependents&quot;: [ &quot;kdk/core.client.js&quot;,&lt;br&gt;                  &quot;kdk/core/client/api.js&quot; ],&lt;br&gt;  &quot;dependencies&quot;: []&lt;br&gt;},&lt;br&gt;&quot;kano/client/components/KLayerList.vue&quot;: {&lt;br&gt;  &quot;dependents&quot;: [],&lt;br&gt;  &quot;dependencies&quot;: [ &quot;kdk/core.client.js&quot; ]&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="560" height="230" as="geometry"/></mxCell>
        <mxCell id="n16" value="Stored on the file entry,&lt;br&gt;not in a fourth collection.&lt;br&gt;&lt;br&gt;That point already exists, is&lt;br&gt;already keyed on (repo, path),&lt;br&gt;already written at step 8 and&lt;br&gt;already deleted when the file&lt;br&gt;goes away.&lt;br&gt;&lt;br&gt;Cost: ~700 Ko over the corpus." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="1300" y="420" width="260" height="230" as="geometry"/></mxCell>
        <mxCell id="n17" value="Rebuilt whole on every run — it cannot be incremental&lt;br&gt;&lt;br&gt;If B is renamed, the edges of every A that imports it change. Those A did not change, so no incremental&lt;br&gt;selection would ever revisit them. One minute for 62 repositories against the 5 minutes of a nightly run, and an&lt;br&gt;e2e test checks that a removed import really disappears from the graph." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1220" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
