  <diagram id="built-overview" name="built · overview">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="What is deployed, and what talks to what. Qdrant is the only channel between the two services." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1480" height="30" as="geometry"/></mxCell>
        <mxCell id="n2" value="knowledge-ingestion  ·  CronJob 03:00" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="380" height="300" as="geometry"/></mxCell>
        <mxCell id="n3" value="ingestion/main.py — 8 steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n2"><mxGeometry x="20" y="40" width="340" height="34" as="geometry"/></mxCell>
        <mxCell id="n4" value="k-clone kalisio all → emptyDir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n2"><mxGeometry x="20" y="84" width="340" height="34" as="geometry"/></mxCell>
        <mxCell id="n5" value="Qwen3-Embedding-0.6B (baked in image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n2"><mxGeometry x="20" y="128" width="340" height="34" as="geometry"/></mxCell>
        <mxCell id="n6" value="writes · never reads back the chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n2"><mxGeometry x="20" y="172" width="340" height="34" as="geometry"/></mxCell>
        <mxCell id="n7" value="no PersistentVolume: the workspace is wiped&lt;br&gt;between runs so a modified repository is&lt;br&gt;always picked up." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n2"><mxGeometry x="20" y="216" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="n8" value="Qdrant  ·  StatefulSet, 20 Gi" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="420" height="380" as="geometry"/></mxCell>
        <mxCell id="n9" value="kalisio_code&lt;br&gt;~36 400 points · vector 1024 · one per chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="n8"><mxGeometry x="20" y="40" width="380" height="50" as="geometry"/></mxCell>
        <mxCell id="n10" value="kalisio_code_files&lt;br&gt;4 208 points · vector [0.0] · one per file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="n8"><mxGeometry x="20" y="100" width="380" height="50" as="geometry"/></mxCell>
        <mxCell id="n11" value="knowledge_metadata&lt;br&gt;1 point · last_ingestion + indexing config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="n8"><mxGeometry x="20" y="160" width="380" height="50" as="geometry"/></mxCell>
        <mxCell id="n12" value="The whole contract between the services.&lt;br&gt;&lt;br&gt;The ingestion job writes; the API only reads.&lt;br&gt;Neither imports the other: two images, two&lt;br&gt;configurations, one agreed payload shape.&lt;br&gt;&lt;br&gt;test/data/expected/file_entry.json pins it." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n8"><mxGeometry x="20" y="226" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="n13" value="knowledge-api  ·  Deployment" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="480" height="300" as="geometry"/></mxCell>
        <mxCell id="n14" value="GET /health   —   no token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n13"><mxGeometry x="20" y="40" width="440" height="34" as="geometry"/></mxCell>
        <mxCell id="n15" value="POST /search · /ask · /file-context   —   JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="n13"><mxGeometry x="20" y="84" width="440" height="34" as="geometry"/></mxCell>
        <mxCell id="n16" value="POST /mcp/   —   JWT · JSON-RPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCD4ED;strokeColor=#6E5AA6;" vertex="1" parent="n13"><mxGeometry x="20" y="128" width="440" height="34" as="geometry"/></mxCell>
        <mxCell id="n17" value="The MCP is mounted inside the API, not deployed&lt;br&gt;beside it: one image, one Service, one Ingress,&lt;br&gt;one secret. search_code calls the retrieval&lt;br&gt;service in Python — no internal HTTP hop." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n13"><mxGeometry x="20" y="172" width="440" height="100" as="geometry"/></mxCell>
        <mxCell id="n18" value="Coding agents" style="swimlane;startSize=28;fontStyle=1;fontSize=13;html=1;fillColor=#DCD4ED;strokeColor=#6E5AA6;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="480" height="180" as="geometry"/></mxCell>
        <mxCell id="n19" value="Claude Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCD4ED;strokeColor=#6E5AA6;" vertex="1" parent="n18"><mxGeometry x="20" y="40" width="200" height="34" as="geometry"/></mxCell>
        <mxCell id="n20" value="Gemini CLI · Codex · Vibe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCD4ED;strokeColor=#6E5AA6;" vertex="1" parent="n18"><mxGeometry x="240" y="40" width="200" height="34" as="geometry"/></mxCell>
        <mxCell id="n21" value="claude mcp add --transport http knowledge \&lt;br&gt;  https://knowledge.dev.kalisio.xyz/mcp \&lt;br&gt;  --header &quot;Authorization: Bearer $JWT&quot;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="n18"><mxGeometry x="20" y="84" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="n22" value="Ingress nginx + cert-manager&lt;br&gt;knowledge.dev.kalisio.xyz — the only way in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1000" y="640" width="480" height="60" as="geometry"/></mxCell>
        <mxCell id="n23" value="62 Kalisio repositories&lt;br&gt;cloned fresh on every run (~3 min)&lt;br&gt;md · js · mjs · cjs · vue · json&lt;br&gt;yaml · yml · yaml.gotmpl · sh  (#12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="e24" value="k-clone" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n23" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" value="upsert" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n2" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e26" value="retrieve / query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n8" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n18" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;fontColor=#555555;" edge="1" parent="1" source="n22" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n29" value="Measured on the nightly run of 31 August:&lt;br&gt;4 208 files · 32 628 chunks · 15 359 commit subjects&lt;br&gt;5 min 33 s end to end, of which 3 min 20 s is the clone.&lt;br&gt;&lt;br&gt;A full rebuild (changed model or chunking version)&lt;br&gt;takes about 10 h: embedding runs on CPU at ~1.3 chunk/s." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="380" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
