        <mxCell id="n13" value="k-clone kalisio all&lt;br&gt;into /workspace (emptyDir)&lt;br&gt;tooling linked from the image" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="n11"><mxGeometry x="340" y="36" width="480" height="50" as="geometry"/></mxCell>
