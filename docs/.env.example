# Reference for every variable read by src/rag_system/config.py.
# Copy to .env for local pytest runs.

# --- Core ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kalisio_code_v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BATCH_SIZE=8
INDEX_VERSION=system.v1

# --- API ---
HOST=127.0.0.1
PORT=8000
WORKERS_COUNT=1
TOP_K=6
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
MAX_CONTEXT_CHARS=14000
MAX_ANSWER_TOKENS=1024

# --- HuggingFace cache (used by api container) ---
HF_HOME=
