<mxfile host="drawio" agent="knowledge docs"><!-- Diagrams of docs/guides/file-formats/markdown.md, exported to docs/public/images/file-formats-markdown-<page name>.svg. --><diagram id="cutting" name="cutting"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Markdown file" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="119" y="0" width="114" height="35" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1 · Parse into atoms&lt;/b&gt;&lt;br/&gt;ExperimentalMarkdownSyntaxTextSplitter&lt;br/&gt;one atom per paragraph, list, table, code block&lt;br/&gt;+ its headings (Header 1..4)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="75" width="351" height="83" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;2 · Merge&lt;/b&gt; consecutive atoms&lt;br/&gt;under the same heading path&lt;br/&gt;while the section stays ≤ 500 chars" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="42" y="198" width="268" height="66" as="geometry"/></mxCell><mxCell id="c6" value="section &gt; 500?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="84" y="304" width="182" height="55" as="geometry"/></mxCell><mxCell id="c7" value="keep" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="146" y="415" width="60" height="35" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;3 · Split&lt;/b&gt; on size&lt;br/&gt;RecursiveCharacterTextSplitter&lt;br/&gt;500 / overlap 80" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="231" y="399" width="233" height="66" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;4 · Prefix&lt;/b&gt;&lt;br/&gt;Context: h1 &gt; h2 &gt; h3&lt;br/&gt;Source: path" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="177" y="505" width="170" height="66" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;5 · Locate&lt;/b&gt; lines" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="194" y="611" width="135" height="35" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;endArrow=classic;startArrow=none;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;endArrow=classic;startArrow=none;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;endArrow=classic;startArrow=none;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;endArrow=classic;startArrow=none;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1